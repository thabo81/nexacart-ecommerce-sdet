# Copy to .env (never commit it). Placeholders only: choose your own local values.
# Used by Docker Compose; the API/worker also read APP_ENV, LOG_LEVEL and DATABASE_URL.

# PostgreSQL container credentials. Use letters and digits only (the value is embedded in a URL).
POSTGRES_USER=nexacart
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexacart

# Host ports (Compose publishes them on 127.0.0.1 only). PostgreSQL is not published.
API_PORT=8000
FRONTEND_PORT=5173

# Application
LOG_LEVEL=INFO
# Only for running the API/tests directly on your machine against your own PostgreSQL.
# Compose builds its own DATABASE_URL (host "db") and ignores this value.
# DATABASE_URL=postgresql+psycopg://nexacart:change-me-local-only@localhost:5432/nexacart
