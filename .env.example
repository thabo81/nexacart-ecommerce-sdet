# Copy to .env (never commit it). Placeholders only; choose your own local values.
# Plain "docker compose up" uses the development stack. Use --profile test for the test stack.
COMPOSE_PROFILES=dev

# PostgreSQL credentials used by the dev and test databases.
# Keep the password to URL-safe letters/digits unless URL-encoding is implemented.
POSTGRES_USER=nexacart
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexacart
POSTGRES_TEST_DB=nexacart_test

# Host ports are bound to 127.0.0.1. PostgreSQL dev DB is not published.
API_PORT=8000
FRONTEND_PORT=5173
TEST_API_PORT=8100
TEST_FRONTEND_PORT=5273
TEST_DB_PORT=55432

# Application
LOG_LEVEL=INFO
# Optional: recorded as "build" in every log line (CI sets the commit SHA).
# BUILD_SHA=unknown

# Pagination (BR-016). Defaults shown; PAGE_SIZE_MAX cannot exceed 48 and the default cannot exceed the max.
# PAGE_SIZE_DEFAULT=12
# PAGE_SIZE_MAX=48

# Only for running API/tests directly on the host against your own PostgreSQL.
# DATABASE_URL=postgresql+psycopg://nexacart:change-me-local-only@localhost:5432/nexacart
# Used by tests/integration/test_readiness_postgres.py when running host-side tests:
# NEXACART_TEST_DATABASE_URL=postgresql+psycopg://nexacart:change-me-local-only@127.0.0.1:55432/nexacart_test
